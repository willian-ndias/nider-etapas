<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ fontes e cores -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Global User Interface</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Global User Interface</FontFamily>

    <Color x:Key="AccentA">#FFE8EBEF</Color>
    <Color x:Key="AccentB">#FFB4BBC4</Color>
    <Color x:Key="RecordColor">#FFFF3B4E</Color>

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentA}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentB}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolid" Color="#FFD2D7DD"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FF12171C"/>
    <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F6"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFAEB4BB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF7E858D"/>
    <SolidColorBrush x:Key="Divider" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="CardFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1FFFFFFF"/>

    <!-- vidro: tinta escura por cima do fundo desfocado -->
    <LinearGradientBrush x:Key="GlassTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0303540" Offset="0"/>
        <GradientStop Color="#C8171B21" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#05FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.6"/>
        <GradientStop Color="#2AFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- fundo das janelas grandes, com "manchas" de luz coloridas -->
    <DrawingBrush x:Key="WindowBackdrop" Stretch="Fill" Viewbox="0,0,100,100" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H100 V100 H0 Z">
                <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1E2329" Offset="0"/>
                            <GradientStop Color="#FF0F1317" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M-30,-40 H70 V50 H-30 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M45,55 H135 V140 H45 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#18FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.30" Color="#FFFFFF"/>

    <!-- ============================================================ ícones (24x24, traço) -->
    <Geometry x:Key="IcLogo">M4,18 H9 V13 H14 V8 H20</Geometry>
    <Geometry x:Key="IcPause">M9,6 V18 M15,6 V18</Geometry>
    <Geometry x:Key="IcPlay">M8,5.5 L18.5,12 L8,18.5 Z</Geometry>
    <Geometry x:Key="IcStop">M7.5,7.5 H16.5 V16.5 H7.5 Z</Geometry>
    <Geometry x:Key="IcDraw">M4,20 L8.5,19 L19,8.5 L15.5,5 L5,15.5 Z M13.5,7 L17,10.5</Geometry>
    <Geometry x:Key="IcPen">M4,20 L8.5,19 L19,8.5 L15.5,5 L5,15.5 Z M13.5,7 L17,10.5</Geometry>
    <Geometry x:Key="IcHighlighter">M4,20 H11 M9,15 L6.5,17.5 L9.5,18.5 L11,17 M9,15 L16.5,7.5 L19.5,10.5 L12,18 Z</Geometry>
    <Geometry x:Key="IcArrow">M5,19 L18.5,5.5 M10,5 H19 V14</Geometry>
    <Geometry x:Key="IcRect">M4.5,6.5 Q4.5,5 6,5 H18 Q19.5,5 19.5,6.5 V17.5 Q19.5,19 18,19 H6 Q4.5,19 4.5,17.5 Z</Geometry>
    <Geometry x:Key="IcEllipse">M3,12 A9,7 0 1 1 21,12 A9,7 0 1 1 3,12 Z</Geometry>
    <Geometry x:Key="IcText">M5,7 V5 H19 V7 M12,5 V19 M9,19 H15</Geometry>
    <Geometry x:Key="IcNumber">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M10.5,9 L12.5,7.5 V16.5</Geometry>
    <Geometry x:Key="IcUndo">M9,14 L4,9 L9,4 M4,9 H14.5 A5.5,5.5 0 0 1 14.5,20 H11</Geometry>
    <Geometry x:Key="IcRedo">M15,14 L20,9 L15,4 M20,9 H9.5 A5.5,5.5 0 0 0 9.5,20 H13</Geometry>
    <Geometry x:Key="IcTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</Geometry>
    <Geometry x:Key="IcClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
    <Geometry x:Key="IcCheck">M5,12.5 L10,17.5 L19,7</Geometry>
    <Geometry x:Key="IcUp">M6,15 L12,9 L18,15</Geometry>
    <Geometry x:Key="IcDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="IcPdf">M14,3 H6.5 Q5,3 5,4.5 V19.5 Q5,21 6.5,21 H17.5 Q19,21 19,19.5 V8 Z M14,3 V8 H19 M8.5,13 H15.5 M8.5,16.5 H13</Geometry>
    <Geometry x:Key="IcFolder">M3,7 Q3,5 5,5 H9.5 L11.5,7.5 H19 Q21,7.5 21,9.5 V17 Q21,19 19,19 H5 Q3,19 3,17 Z</Geometry>
    <Geometry x:Key="IcMin">M6,12 H18</Geometry>
    <Geometry x:Key="IcMax">M6.5,6.5 H17.5 V17.5 H6.5 Z</Geometry>
    <Geometry x:Key="IcClear">M5,19 H19 M7,15 L15,7 L19,11 L13,17 H9 Z</Geometry>
    <Geometry x:Key="IcRecordAgain">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M9,12 A3,3 0 1 1 15,12 A3,3 0 1 1 9,12 Z</Geometry>
    <Geometry x:Key="IcClick">M8,4 V17.5 L11.4,14.6 L13.6,19.6 L15.6,18.7 L13.4,13.8 L17.8,13.4 Z M3.5,8 L5.5,8.6 M5.2,3.4 L6.4,5.2 M10.5,2.8 L10.2,4.8</Geometry>
    <Geometry x:Key="IcCrop">M7,3 V17 H21 M3,7 H17 V21</Geometry>
    <Geometry x:Key="IcPhoto">M4.5,6.5 Q4.5,5 6,5 H18 Q19.5,5 19.5,6.5 V17.5 Q19.5,19 18,19 H6 Q4.5,19 4.5,17.5 Z M4.5,16 L9.5,11 L14,15.5 L16,13.5 L19.5,17 M15.5,9 A1.2,1.2 0 1 1 15.49,9 Z</Geometry>
    <Geometry x:Key="IcDownload">M12,4 V15 M7,10.5 L12,15.5 L17,10.5 M5,20 H19</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.9"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- ============================================================ dicas (tooltip) -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F0202429" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ botões -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="12"/>
                        <Border x:Name="on" Background="{StaticResource AccentBrush}" CornerRadius="12" Opacity="0" Effect="{StaticResource AccentGlow}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="on" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="ring" Width="28" Height="28" Stroke="White" StrokeThickness="2" Opacity="0"/>
                        <Ellipse Width="20" Height="20" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tamanho do traço: três bolinhas de tamanhos diferentes -->
    <Style x:Key="SizeToggle" TargetType="RadioButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                        <Ellipse x:Name="dot" Width="{TemplateBinding Tag}" Height="{TemplateBinding Tag}" Fill="{StaticResource TextSecondary}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            <Setter TargetName="dot" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="13" Effect="{StaticResource AccentGlow}"/>
                        <Border x:Name="hl" CornerRadius="13" Background="{StaticResource GlassSheen}" BorderBrush="#55FFFFFF" BorderThickness="1"/>
                        <Border x:Name="hover" CornerRadius="13" Background="White" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.10"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="12">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="12">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- botão de janela (minimizar / maximizar / fechar) -->
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <!-- ============================================================ campos de texto -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSolid}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMuted}" Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentSolid}"/>
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ interruptor (checkbox) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="11" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                            <Border x:Name="trackOn" CornerRadius="11" Background="{StaticResource AccentBrush}" Opacity="0"/>
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trackOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="knob" Property="Margin" Value="21,0,0,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ barra de progresso -->
    <Style x:Key="GlassProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="4" Background="#1FFFFFFF"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Effect="{StaticResource AccentGlow}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ barra de rolagem fininha -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="t" CornerRadius="4" Background="#33FFFFFF" Margin="2,2"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="t" Property="Background" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ cartões de passo na revisão -->
    <Style x:Key="StepCard" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="16" Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"/>
                        <Border x:Name="sel" CornerRadius="16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#26FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="10"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="sel" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource StepCard}"/>
    </Style>

    <!-- texto -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <!-- opção em chip (recorte, marcador do clique) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="11,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSolid}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
