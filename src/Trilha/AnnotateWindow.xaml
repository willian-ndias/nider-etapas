<Window x:Class="Trilha.AnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Trilha"
        Title="Nider Etapas" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" Background="#FF14181D">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- barra de título (só no modo editar) -->
        <Grid x:Name="TitleBar" Height="48" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                <Image Source="{StaticResource NiderLogo}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="WindowTitle" Text="Editar passo" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Button Style="{StaticResource ChromeButton}" Click="Min_Click"><Path Data="{StaticResource IcMin}" Style="{StaticResource Icon}" Width="14" Height="14"/></Button>
                <Button Style="{StaticResource ChromeButton}" Click="Max_Click"><Path Data="{StaticResource IcMax}" Style="{StaticResource Icon}" Width="13" Height="13"/></Button>
                <Button Style="{StaticResource ChromeButton}" Click="Cancel_Click"><Path Data="{StaticResource IcClose}" Style="{StaticResource Icon}" Width="14" Height="14"/></Button>
            </StackPanel>
        </Grid>

        <!-- imagem para desenhar -->
        <local:AnnotationSurface x:Name="Surface" Grid.Row="2"/>

        <!-- paleta de vidro (flutua sobre a tela congelada) -->
        <Grid x:Name="Floating" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FloatingMove"/>
            </Grid.RenderTransform>
            <Border CornerRadius="22" Background="#01000000" Effect="{StaticResource SoftShadow}"/>
            <Grid x:Name="PaletteShell">
                <Border x:Name="FrostImage">
                    <Border.Effect>
                        <BlurEffect Radius="9" KernelType="Gaussian"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="22" Background="{StaticResource GlassTint}"/>
                <Border CornerRadius="22" Background="{StaticResource GlassSheen}"/>
                <Border CornerRadius="22" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"/>
                <StackPanel Margin="10">
                    <local:ToolPalette x:Name="Palette"/>
                    <Grid x:Name="CommentRow" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OverlayComment" Style="{StaticResource GlassTextBox}" Tag="Escreva a explicação deste passo (opcional)"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Cancelar" Margin="10,0,0,0" Click="Cancel_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Accept_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcCheck}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Adicionar ao manual"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- campos (só no modo editar) -->
        <Grid x:Name="Fields" Grid.Row="3" Margin="18,12,18,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DESCRIÇÃO" Style="{StaticResource Label}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource GlassTextBox}" Tag="O que fazer neste passo"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="OBSERVAÇÃO" Style="{StaticResource Label}"/>
                <TextBox x:Name="CommentBox" Style="{StaticResource GlassTextBox}" Tag="Opcional"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Salvar passo" Margin="8,0,0,0" Click="Accept_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
