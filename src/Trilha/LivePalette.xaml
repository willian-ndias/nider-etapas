<Window x:Class="Trilha.LivePalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Trilha"
        Title="Nider Etapas" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Grid Margin="16,10,16,22">
        <Border CornerRadius="22" Background="#01000000" Effect="{StaticResource SoftShadow}"/>
        <Grid x:Name="Shell">
            <Border x:Name="FrostImage"/>
            <Border CornerRadius="22" Background="{StaticResource GlassTint}"/>
            <Border CornerRadius="22" Background="{StaticResource GlassSheen}"/>
            <Border CornerRadius="22" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"/>
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1" CornerRadius="12" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeLive" GroupName="mode" Style="{StaticResource Chip}" Checked="Mode_Changed"
                                         ToolTip="Use o computador normalmente: os desenhos ficam por cima e nenhum clique vira print">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcClick}" Style="{StaticResource Icon}" Width="15" Height="15" Margin="0,0,6,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Mexer na tela"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeDraw" GroupName="mode" Style="{StaticResource Chip}" Checked="Mode_Changed"
                                         ToolTip="Desenhar setas, quadros e textos por cima da tela">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcDraw}" Style="{StaticResource Icon}" Width="15" Height="15" Margin="0,0,6,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Desenhar"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="26" Background="{StaticResource Divider}" Margin="8,0"/>
                    <local:ToolPalette x:Name="Palette"/>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Comment" Style="{StaticResource GlassTextBox}" Tag="Explicação deste print (opcional)"/>
                    <Button x:Name="FreezeButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Freeze_Click"
                            ToolTip="Para a tela como está agora (útil para menus que somem)">
                        <TextBlock x:Name="FreezeText" Text="Congelar tela"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Fechar" Margin="8,0,0,0" Click="Close_Click"
                            ToolTip="Fecha a paleta e volta a gravar cada clique (Esc)"/>
                    <Button x:Name="ShotButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Shot_Click"
                            ToolTip="Vira um passo com a tela e os desenhos (Ctrl+Shift+D)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcPhoto}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Tirar print"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="Hint" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="4,8,4,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
