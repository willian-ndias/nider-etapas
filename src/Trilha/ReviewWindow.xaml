<Window x:Class="Trilha.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nider Etapas" Width="1320" Height="840" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Background="{StaticResource WindowBackdrop}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================================================== topo -->
        <Grid Margin="20,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource NiderLogo}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="AppName" Text="Nider Etapas" Style="{StaticResource Title}" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Border Width="1" Height="22" Background="{StaticResource Divider}" Margin="16,0"/>
            </StackPanel>
            <TextBox x:Name="TitleBox" Grid.Column="1" Style="{StaticResource GlassTextBox}" FontSize="15" FontWeight="SemiBold"
                     MaxWidth="560" HorizontalAlignment="Left" MinWidth="380" VerticalAlignment="Center"
                     Tag="Título do manual" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                <Button Style="{StaticResource ChromeButton}" Click="Min_Click"><Path Data="{StaticResource IcMin}" Style="{StaticResource Icon}" Width="14" Height="14"/></Button>
                <Button Style="{StaticResource ChromeButton}" Click="Max_Click"><Path Data="{StaticResource IcMax}" Style="{StaticResource Icon}" Width="13" Height="13"/></Button>
                <Button Style="{StaticResource ChromeButton}" Click="Close_Click"><Path Data="{StaticResource IcClose}" Style="{StaticResource Icon}" Width="14" Height="14"/></Button>
            </StackPanel>
        </Grid>

        <!-- ==================================================== conteúdo -->
        <Grid Grid.Row="1" Margin="20,4,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- lista de passos -->
            <Grid Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,10">
                    <TextBlock x:Name="CountText" Text="PASSOS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="Auto" Height="34" Padding="10,0" Click="AddText_Click" ToolTip="Adicionar um bloco de texto depois do passo selecionado" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcText}" Style="{StaticResource Icon}" Width="15" Height="15"/>
                                <TextBlock Text="Texto" Foreground="{StaticResource TextPrimary}" FontSize="12.5" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Up_Click" ToolTip="Subir o passo">
                            <Path Data="{StaticResource IcUp}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Down_Click" ToolTip="Descer o passo">
                            <Path Data="{StaticResource IcDown}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Delete_Click" ToolTip="Excluir o passo (Delete)">
                            <Path Data="{StaticResource IcTrash}" Style="{StaticResource Icon}" Width="16" Height="16" Stroke="#FFFF7A8C"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="10" Height="72" ClipToBounds="True" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,2,4,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="7" Padding="8,2" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource OnAccent}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" Margin="0,6,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- passo selecionado -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ImageCard" CornerRadius="20" Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="Preview" Grid.Row="1" Margin="0,12,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                               MouseLeftButtonDown="Preview_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="MarkerButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Marker_Click"
                                    ToolTip="Formato e cor do destaque do clique">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcClick}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Marcador do clique"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CropButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Crop_Click"
                                    ToolTip="Recortar o print e colocar borda">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcCrop}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Recortar e borda"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PhotoButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Photo_Click"
                                    ToolTip="Usar outra imagem neste passo">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcPhoto}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Trocar imagem"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DrawButton" Style="{StaticResource PrimaryButton}" Click="Draw_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcDraw}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Desenhar nesta imagem"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="StepFields" Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="DESCRIÇÃO" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource GlassTextBox}" Tag="O que fazer neste passo"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" TextChanged="Description_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <TextBlock Text="OBSERVAÇÃO" Style="{StaticResource Label}"/>
                        <TextBox x:Name="CommentBox" Style="{StaticResource GlassTextBox}" Tag="Explique algo a mais (opcional)"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" TextChanged="Comment_Changed"/>
                    </StackPanel>
                </Grid>
                <!-- bloco de texto (sem print) -->
                <Border x:Name="TextPanel" Grid.RowSpan="2" CornerRadius="20" Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardStroke}"
                        BorderThickness="1" Padding="22,18" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="TÍTULO (OPCIONAL)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TextTitleBox" Grid.Row="1" Style="{StaticResource GlassTextBox}" FontSize="16" FontWeight="SemiBold"
                                 Tag="Ex.: Antes de começar" TextChanged="TextTitle_Changed"/>
                        <TextBlock Grid.Row="2" Text="TEXTO" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <TextBox x:Name="TextBodyBox" Grid.Row="3" Style="{StaticResource GlassTextBox}" FontSize="14"
                                 Tag="Escreva aqui. Cada Enter começa um parágrafo novo." TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="TextBody_Changed"/>
                        <TextBlock Grid.Row="4" Text="Este bloco entra no PDF entre os passos, sem print e sem número." Style="{StaticResource Body}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================================================== rodapé -->
        <Grid Grid.Row="2" Margin="20,16,20,18">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Discard_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcRecordAgain}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Descartar e começar outro"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Voltar e continuar gravando" Click="Continue_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Save_Click" Padding="24,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcPdf}" Style="{StaticResource Icon}" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Salvar PDF" FontSize="15"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================================================== gerando o PDF -->
        <Grid x:Name="Busy" Grid.RowSpan="3" Background="#B314181D" Visibility="Collapsed">
            <Border CornerRadius="22" Background="#F0202429" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,28" Effect="{StaticResource SoftShadow}">
                <StackPanel Width="300">
                    <TextBlock Text="Gerando o PDF..." Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock Text="Montando o manual com os prints e os seus desenhos." Style="{StaticResource Body}" Margin="0,6,0,18"/>
                    <ProgressBar Style="{StaticResource GlassProgress}" IsIndeterminate="False" x:Name="BusyBar" Maximum="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
