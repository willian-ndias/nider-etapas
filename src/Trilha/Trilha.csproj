<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NiderEtapas</AssemblyName>
    <RootNamespace>Trilha</RootNamespace>
    <Product>Nider Etapas</Product>
    <Company>Nider</Company>
    <Authors>Willian Dias</Authors>
    <Copyright>© 2026 Willian Dias · Nider · nider.com.br</Copyright>
    <Description>Nider Etapas by nider.com.br</Description>
    <Description>Nider Etapas - manuais passo a passo</Description>
    <Version>2.0.0</Version>
    <ApplicationIcon>nider.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" />
    <Resource Include="nider.ico" />
    <Resource Include="logo.png" />
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" /><EmbeddedResource Include="logo-faint.png" LogicalName="logo-faint.png"/>
  </ItemGroup>

</Project>
